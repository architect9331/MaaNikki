{
  "interface_version": 2,
  "name": "MaaNikki",
  "label": "MaaNikki",
  "title": "MaaNikki - 无限暖暖自动化",
  "icon": "resource/icon.png",
  "description": "《无限暖暖》助手，以祝福闪光一键全收集为特色，支持日常任务、幻境挑战、巅峰赛和常驻辅助功能。",
  "version": "0.8.3",
  "github": "https://github.com/architect9331/MaaNikki",
  "telemetry": {
    "sentry": {
      "dsn": "https://a18b13840bf32739804bf70e57a0beb4@o4512306542936064.ingest.us.sentry.io/4512306595561472",
      "environment": "production",
      "tracing": true,
      "traces_sample_rate": 0.1,
      "failure_attachments_sample_rate": 1.0
    }
  },
  "controller": [
    {
      "name": "nikki_windows",
      "label": "无限暖暖（Windows）",
      "description": "连接无限暖暖 PC 客户端窗口。所有自动任务均需要实际为 16:9 的游戏画面，推荐 1920×1080。",
      "type": "Win32",
      "permission_required": true,
      "display_short_side": 720,
      "win32": {
        "class_regex": "^UnrealWindow$",
        "window_regex": "^\\s*(Infinity Nikki|无限暖暖)\\s*$",
        "screencap": "FramePool",
        "mouse": "Seize",
        "keyboard": "Seize"
      }
    }
  ],
  "resource": [
    {
      "name": "main_resource",
      "label": "MaaNikki 通用资源",
      "path": [
        "./resource"
      ]
    }
  ],
  "agent": {
    "child_exec": "./python/python.exe",
    "child_args": [
      "./agent/main.py"
    ]
  },
  "group": [
    {
      "name": "energy",
      "label": "幻境",
      "default_expand": true
    },
    {
      "name": "daily",
      "label": "其他每日任务",
      "default_expand": true
    },
    {
      "name": "collection",
      "label": "祝福闪光",
      "default_expand": true
    },
    {
      "name": "developer",
      "label": "开发者工具",
      "default_expand": true
    },
    {
      "name": "developer_zhaoxi",
      "label": "朝夕子任务测试",
      "default_expand": true
    },
    {
      "name": "developer_xinghai",
      "label": "星海子任务测试",
      "default_expand": true
    }
  ],
  "task": [],
  "import": [
    "options/GameKeys.json",
    "tasks/StartGame.json",
    "tasks/Dig.json",
    "tasks/Zhaoxi.json",
    "tasks/Energy.json",
    "tasks/StarlightCrystals.json",
    "tasks/Xinghai.json",
    "tasks/Home.json",
    "tasks/MonthlyPass.json",
    "tasks/Mailbox.json",
    "tasks/WeeklyFreeGifts.json",
    "tasks/MonthlyCrystalExchange.json",
    "tasks/Crown.json",
    "tasks/Exploration.json",
    "tasks/Fishing.json",
    "tasks/BlessingLock.json",
    "tasks/BlessingUpgrade.json",
    "tasks/RouteTest.json",
    "tasks/SubtaskTest.json",
    "tasks/Presets.json"
  ]
}
