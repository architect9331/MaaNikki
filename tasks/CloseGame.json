{
    "task": [
        {
            "name": "close_game",
            "label": "关闭游戏",
            "entry": "MaaNikki_CloseGame",
            "group": ["posttask"],
            "default_check": false,
            "description": "请放在任务队列末尾。执行到本任务时，先将 MaaNikki 窗口置前并倒计时 15 秒（期间可随时停止），随后请求关闭当前连接的游戏窗口并等待游戏进程退出；未正常退出时，日志会给出窗口与进程的观测状态，默认不强制结束。前序任务失败导致队列停止时，本任务不会执行。默认不关闭官方启动器，可在选项中开启；开启后按注册表与安装配置识别官方启动器路径，无法确认身份时跳过。",
            "option": ["ForceCloseOnTimeout", "CloseLauncher"]
        }
    ],
    "option": {
        "ForceCloseOnTimeout": {
            "type": "switch",
            "label": "正常退出超时后强制结束",
            "description": "关闭等待超时（含窗口已消失但进程未退出的情形）后，强制结束当前连接的游戏进程，可能中断尚未完成的操作，请确认后再开启。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "MaaNikki_CloseGame": {"custom_action_param": {"force_on_timeout": true}}
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "MaaNikki_CloseGame": {"custom_action_param": {"force_on_timeout": false}}
                    }
                }
            ],
            "default_case": "No"
        },
        "CloseLauncher": {
            "type": "switch",
            "label": "同时关闭官方启动器",
            "description": "游戏关闭后，按注册表与安装配置解析出与本次游戏安装关联的官方启动器路径（无法确定关联时跳过）并请求其退出；启动器窗口未出现时会短暂等待（约 10 秒），不强制结束。启动器仅驻留托盘时无法关闭。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "MaaNikki_CloseGame": {"custom_action_param": {"close_launcher": true}}
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "MaaNikki_CloseGame": {"custom_action_param": {"close_launcher": false}}
                    }
                }
            ],
            "default_case": "No"
        }
    }
}
