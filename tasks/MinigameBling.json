{
  "task": [
    {
      "name": "minigame_bling",
      "label": "小游戏刷噗灵",
      "entry": "MaaNikki_MinigameBling",
      "group": ["daily", "periodic"],
      "default_check": false,
      "description": "前往花愿镇心愿花街左上方「穿梭大冒险」小游戏，自动对话并穿过激光门完成挑战与连续再次挑战，稳定拿满每日 16 万大世界噗灵上限。",
      "option": ["MinigameBlingTarget", "MinigameBlingCameraAssist", "MinigameBlingStartMode", "MinigameBlingBackground"]
    }
  ],
  "option": {
    "MinigameBlingTarget": {
      "type": "select",
      "label": "目标噗灵与局数",
      "default_case": "Full160k",
      "description": "每局耗时约 31 秒，净收益 600～1600 噗灵。大世界每日噗灵获取上限为 16 万，检测到游戏上限提示时会自动提前结束。",
      "cases": [
        {
          "name": "Full160k",
          "label": "拿满 16 万每日上限（最多 267 局，检测到上限自动停）",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "rounds": 267
              }
            }
          }
        },
        {
          "name": "Half80k",
          "label": "刷取约 8 万噗灵（134 局，约 70 分钟）",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "rounds": 134
              }
            }
          }
        },
        {
          "name": "Quarter40k",
          "label": "刷取约 4 万噗灵（67 局，约 35 分钟）",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "rounds": 67
              }
            }
          }
        },
        {
          "name": "Quick20",
          "label": "速刷 20 局（约 10 分钟）",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "rounds": 20
              }
            }
          }
        },
        {
          "name": "Trial3",
          "label": "试跑 3 局（验证路线与按键）",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "rounds": 3
              }
            }
          }
        }
      ]
    },
    "MinigameBlingCameraAssist": {
      "type": "select",
      "label": "视角水平辅助",
      "default_case": "Enabled",
      "description": "请与游戏内「设置 → 控制 → 视角水平辅助」开关保持一致：开启时使用默认顺滑跟转走法，关闭时使用定角补转走法（两种走法均全程纯键盘操作，支持后台运行）。",
      "cases": [
        {
          "name": "Enabled",
          "label": "已开启视角水平辅助（默认）",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "camera_assist": true
              }
            }
          }
        },
        {
          "name": "Disabled",
          "label": "已关闭视角水平辅助",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "camera_assist": false
              }
            }
          }
        }
      ]
    },
    "MinigameBlingStartMode": {
      "type": "select",
      "label": "起点方式",
      "default_case": "AutoNavigate",
      "description": "默认自动传送到「心愿花街」并沿道路前往「穿梭大冒险」NPC 处；若已手动站在 NPC 旁可选择直接开始。",
      "cases": [
        {
          "name": "AutoNavigate",
          "label": "自动传送并前往 NPC（已在 NPC 旁时自动跳过跑图）",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "navigate": true
              }
            }
          }
        },
        {
          "name": "AtNpc",
          "label": "已在 NPC 旁直接开始（不传送不跑图）",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "navigate": false
              }
            }
          }
        }
      ]
    },
    "MinigameBlingBackground": {
      "type": "switch",
      "label": "挑战阶段后台运行",
      "default_case": "Yes",
      "description": "开启后，到达 NPC 并进入对话、挑战与结算阶段时改为向游戏窗口直接发送按键与点击，切出游戏不会自动暂停或强行切回前台（需保持窗口不最小化，并使用 FramePool 等支持后台截图的方式；初始寻路跑图仍在前台执行）。关闭则全程要求游戏保持前台。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "background": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_MinigameBling": {
              "custom_action_param": {
                "background": false
              }
            }
          }
        }
      ]
    }
  }
}
