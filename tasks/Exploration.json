      "cases": [
        {"name": "Yes", "label": "开启", "pipeline_override": {"MaaNikki_Assist_Dialogue": {"custom_action_param": {"value": true}}}},
        {"name": "No", "label": "关闭", "pipeline_override": {"MaaNikki_Assist_Dialogue": {"custom_action_param": {"value": false}}}}
