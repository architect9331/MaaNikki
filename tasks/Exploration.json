        {"name": "No", "label": "关闭", "pipeline_override": {"MaaNikki_Assist_Pickup": {"custom_action_param": {"value": false}}}}
      ]
    },
    "AssistClear": {
      "type": "switch", "label": "清洁动画跳过", "default_case": "Yes",
