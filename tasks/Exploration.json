{
  "task": [
    {
      "name": "exploration",
      "label": "开荒辅助",
      "entry": "MaaNikki_Exploration",
      "group": [
        "assist"
      ],
      "default_check": false,
      "description": "持续处理拾取、清洁跳过和对白推进，停止任务后结束。钓鱼先手动抛竿；钓鱼与鼠标操作在游戏前台执行，键盘交互支持后台。",
      "option": [
        "AssistPickup",
        "AssistClear",
        "AssistDialogue",
        "AssistFishing"
      ]
    }
  ],
  "option": {
    "AssistPickup": {
      "type": "switch",
      "label": "自动拾取",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_Pickup": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_Pickup": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "AssistClear": {
      "type": "switch",
      "label": "清洁动画跳过",
      "default_case": "Yes",
      "description": "出现跳过提示时执行一次跳过，等待提示消失后继续。部分剧情动画也可能使用相同提示。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_Clear": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_Clear": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "AssistDialogue": {
      "type": "switch",
      "label": "自动对话",
      "default_case": "Yes",
      "description": "出现推进提示时继续对白，对话分支由你选择。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_Dialogue": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_Dialogue": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "AssistFishing": {
      "type": "switch",
      "label": "自动钓鱼",
      "default_case": "No",
      "description": "手动抛竿后自动提竿、拉线和收线。普通钓鱼默认最多 3 竿，家园钓星默认最多 5 竿；切出游戏时暂停。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_Fishing": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_Fishing": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    }
  }
}
