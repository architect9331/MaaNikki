{
  "task": [
    {
      "name": "exploration",
      "label": "开荒辅助",
      "entry": "MaaNikki_Exploration",
      "group": [
        "assist"
      ],
      "default_check": false,
      "description": "持续辅助拾取、清洁跳过、对白和钓鱼。可叠加美鸭梨未收集点位，支持大地图和小地图；停止任务后结束。钓鱼先手动抛竿。",
      "option": [
        "AssistPickup",
        "AssistClear",
        "AssistDialogue",
        "AssistFishing",
        "AssistMapStar",
        "AssistMapDewdrop"
      ]
    }
  ],
  "option": {
    "AssistPickup": {
      "type": "switch",
      "label": "自动拾取",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_Pickup": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_Pickup": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "AssistClear": {
      "type": "switch",
      "label": "清洁动画跳过",
      "default_case": "Yes",
      "description": "出现跳过提示时执行一次跳过，等待提示消失后继续。部分剧情动画也可能使用相同提示。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_Clear": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_Clear": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "AssistDialogue": {
      "type": "switch",
      "label": "自动对话",
      "default_case": "Yes",
      "description": "出现推进提示时继续对白，对话分支由你选择。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_Dialogue": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_Dialogue": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "AssistFishing": {
      "type": "switch",
      "label": "自动钓鱼",
      "default_case": "No",
      "description": "手动抛竿后自动提竿、拉线和收线。普通钓鱼默认最多 3 竿，家园钓星默认最多 5 竿；切出游戏时暂停。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_Fishing": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_Fishing": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "AssistMapStar": {
      "type": "switch",
      "label": "奇想星地图标记",
      "default_case": "No",
      "description": "在设置的通用页面登录美鸭梨后，标记未收集的奇想星。打开大地图自动识别常用缩放并校准，返回场景后跟随小地图。支持奇迹大陆、万相境及 16:9 窗口。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_MapStar": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_MapStar": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "AssistMapDewdrop": {
      "type": "switch",
      "label": "灵感露珠地图标记",
      "default_case": "No",
      "description": "在设置的通用页面登录美鸭梨后，标记未收集的灵感露珠。打开大地图自动识别常用缩放并校准，返回场景后跟随小地图。支持奇迹大陆、万相境及 16:9 窗口。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Assist_MapDewdrop": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Assist_MapDewdrop": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    }
  }
}
