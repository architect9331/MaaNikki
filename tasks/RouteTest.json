{
  "task": [{
    "name": "route_test",
    "label": "路线测试",
    "entry": "MaaNikki_RouteTest",
    "group": ["developer"],
    "developer_only": true,
    "default_check": false,
    "description": "选择执行内容和路线，按点位运行。切出游戏后暂停，切回继续。",
    "option": ["RouteTestMode"]
  }],
  "option": {
    "RouteTestFile": {
      "type": "input",
      "label": "路线文件",
      "description": "单条路线位于 resource/routes/daily/；星海合集为 resource/routes/collections/starsea_all.json。记录保存到 logs/navigation/。",
      "inputs": [{"name": "file", "label": "路线 JSON", "default": "", "input_type": "file"}],
      "pipeline_override": {"MaaNikki_RouteTest": {"custom_action_param": {"route": "", "file": "{file}"}}}
    },
    "RouteTestMode": {
      "type": "select",
      "label": "执行内容",
      "default_case": "movement",
      "cases": [
        {
          "name": "movement",
          "label": "路线导航",
          "description": "执行移动、跳跃、传送和等待，跳过采集、拍照等任务动作。",
          "option": ["RouteTestFile"],
          "pipeline_override": {"MaaNikki_RouteTest": {"custom_action_param": {"mode": "movement"}}}
        },
        {
          "name": "map_compare",
          "label": "大小地图定位对照",
          "description": "从星梦群屿·海滩出发，在起点及路线二四个点停稳，记录大小地图坐标、差值和截图。",
          "pipeline_override": {"MaaNikki_RouteTest": {"custom_action_param": {"mode": "movement", "route": "xinghai_bottle_map_compare", "file": ""}}}
        },
        {
          "name": "home",
          "label": "家园完整流程",
          "description": "按家园路线执行钓星、下落攻击、传送和等待，消耗实际钓星次数。",
          "option": ["RouteTestFile", "HomeAbilityPlan"],
          "pipeline_override": {"MaaNikki_RouteTest": {"custom_action_param": {"mode": "home"}}}
        },
        {
          "name": "bottle",
          "label": "漂流瓶全点位",
          "description": "逐点尝试拾取，成功后继续跑完整条路线，记录各点结果及总拾取次数。",
          "option": ["RouteTestBottleRoute"],
          "pipeline_override": {"MaaNikki_RouteTest": {"custom_action_param": {"mode": "bottle"}}}
        }
      ]
    },
    "RouteTestBottleRoute": {
      "type": "select",
      "label": "漂流瓶路线",
      "default_case": "original",
      "cases": [
        {
          "name": "original",
          "label": "路线 1 · 无界枢纽（原有 6 点）",
          "description": "从无界枢纽出发，按原路线逐点尝试拾取。",
          "pipeline_override": {"MaaNikki_RouteTest": {"custom_action_param": {"route": "xinghai_bottle", "file": ""}}}
        },
        {
          "name": "route2",
          "label": "路线 2 · 星梦群屿·海滩（4 个点）",
          "description": "从星梦群屿·海滩出发，先检查最新点位，再按顺序检查之前三个点，拾取成功后继续。",
          "pipeline_override": {"MaaNikki_RouteTest": {"custom_action_param": {"route": "xinghai_bottle_2", "file": ""}}}
        },
        {
          "name": "file",
          "label": "本地路线文件",
          "option": ["RouteTestFile"]
        }
      ]
    }
  }
}
