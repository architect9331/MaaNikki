      "type": "checkbox",
      "label": "购买项目",
      "description": "可单独选择能量结晶或闪亮泡泡，也可两项都选。余额不足时自动跳过对应项，不会误记已完成。",
      "cases": [
        {
          "name": "EnergyCrystal",
          "label": "能量结晶（5万星实/周）",
          "pipeline_override": {
            "MaaNikki_WeeklyHomeShop": {
              "custom_action_param": {
                "energy_crystal": true
              }
            }
          }
        },
        {
          "name": "ShinyBubbles",
          "label": "闪亮泡泡x80（8千×10/周）",
          "pipeline_override": {
            "MaaNikki_WeeklyHomeShop": {
              "custom_action_param": {
                "shiny_bubbles": true
              }
            }
          }
        }
      ],
      "default_case": ["EnergyCrystal", "ShinyBubbles"],
      "min_count": 1,
      "max_count": 2
    }
  }
}
