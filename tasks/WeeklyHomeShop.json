{
  "task": [
    {
      "name": "weekly_home_shop",
      "label": "每周园宝小铺",
      "entry": "MaaNikki_WeeklyHomeShop",
      "group": ["periodic"],
      "default_check": true,
      "description": "前往家园「园宝小铺 → 园宝严选」，消耗万象星实购买每周限购的能量结晶和/或闪亮泡泡，记录每项购买状态。本周所选项目完成后自动跳过，下周恢复。",
      "option": ["HomeShopItems"]
    }
  ],
  "option": {
