{
  "task": [
    {
      "name": "BlingCombat",
      "label": "大世界刷噗灵（扇套站桩）",
      "entry": "MaaNikki_BlingCombat",
      "default_check": false,
      "description": "面向拥有扇套「万相渡浮生（化万相）」的玩家：自动传送并讨伐大世界贪心钱袋与伊赞之土夺夺鸟，击杀后利用化万相两段视野站桩直接吸光爆落噗灵。建议提前备好神女/净化套装并点满无限之心的弓箭自动回能上限。",
      "option": [
        "BlingCombatTarget",
        "BlingCombatEnsureFan",
        "BlingCombatFanPlan",
        "BlingCombatBlackHole",
        "BlingCombatWindmill",
        "BlingCombatSlot"
      ]
    }
  ],
  "option": {
    "BlingCombatTarget": {
      "type": "select",
      "label": "讨伐目标路线",
      "default_case": "GuaranteedPouch",
      "description": "选择刷取的怪物路线。必刷钱袋耗时短、收益稳；夺夺鸟位于伊赞之土；全钱袋会顺路快检随机刷新点（随机点默认仅轻击不耗黑洞能量）。",
      "cases": [
        {
          "name": "GuaranteedPouch",
          "label": "必刷贪心钱袋（7 处每日固定点，推荐首刷）",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "target_mode": "greedy_pouch_guaranteed"
              }
            }
          }
        },
        {
          "name": "BothGuaranteed",
          "label": "必刷钱袋 + 夺夺鸟连刷",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "target_mode": "both_guaranteed"
              }
            }
          }
        },
        {
          "name": "DuoduoBird",
          "label": "伊赞之土夺夺鸟（19 处地面可达点）",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "target_mode": "duoduo_bird"
              }
            }
          }
        },
        {
          "name": "AllPouch",
          "label": "全部贪心钱袋（36 处固定+随机快检）",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "target_mode": "greedy_pouch_all"
              }
            }
          }
        }
      ]
    },
    "BlingCombatEnsureFan": {
      "type": "switch",
      "label": "开跑前自动开启化万相（扇套吸噗灵）",
      "default_case": "Yes",
      "description": "开跑前自动检查并开启「万相渡浮生·化万相」常驻吸噗灵能力；若已提前手动开启化万相也可开启由程序自动确认跳过。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启（推荐）",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "ensure_fan_absorb": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭（需自行确保化万相已开启）",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "ensure_fan_absorb": false
              }
            }
          }
        }
      ]
    },
    "BlingCombatFanPlan": {
      "type": "select",
      "label": "化万相所在能力方案",
      "default_case": "Plan3",
      "description": "指定「化万相」（自动拾取噗灵）存放或允许自动装配的能力方案页，开启后即使切回神女或净化套装仍可常驻生效。",
      "cases": [
        {
          "name": "Plan1",
          "label": "方案一",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "fan_ability_plan": 1
              }
            }
          }
        },
        {
          "name": "Plan2",
          "label": "方案二",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "fan_ability_plan": 2
              }
            }
          }
        },
        {
          "name": "Plan3",
          "label": "方案三（默认）",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "fan_ability_plan": 3
              }
            }
          }
        }
      ]
    },
    "BlingCombatBlackHole": {
      "type": "switch",
      "label": "神女黑洞（E 技能）能量保护释放",
      "default_case": "Yes",
      "description": "在必刷怪点估算能量满 400 时按 E 释放聚怪黑洞，能量不足时不盲按并自动改用风车或轻击；随机钱袋点自动改用轻击以节省能量。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_blackhole_enabled": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_blackhole_enabled": false
              }
            }
          }
        }
      ]
    },
    "BlingCombatWindmill": {
      "type": "switch",
      "label": "幻蝶风车（R 技能）辅助清场",
      "default_case": "Yes",
      "description": "能量介于 200–399 时自动释放 360° 幻蝶风车补伤并接轻击收尾，无需依赖镜头瞄准蓄力。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_windmill_enabled": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_windmill_enabled": false
              }
            }
          }
        }
      ]
    },
    "BlingCombatSlot": {
      "type": "select",
      "label": "战斗能力快捷键槽位",
      "default_case": "KeepCurrent",
      "description": "开启化万相并准备跑图前按指定数字键切换至神女/净化套装；若默认方案主槽位即为神女或净化可保持不切换。",
      "cases": [
        {
          "name": "KeepCurrent",
          "label": "保持当前能力不切换",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 0
              }
            }
          }
        },
        {
          "name": "Slot1",
          "label": "能力槽 1",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 1
              }
            }
          }
        },
        {
          "name": "Slot2",
          "label": "能力槽 2",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 2
              }
            }
          }
        },
        {
