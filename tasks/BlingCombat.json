          "label": "能力槽 3",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 3
              }
            }
          }
        },
        {
          "name": "Slot4",
          "label": "能力槽 4",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 4
              }
            }
          }
        },
        {
          "name": "Slot5",
          "label": "能力槽 5",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 5
              }
            }
          }
        },
        {
          "name": "Slot6",
          "label": "能力槽 6",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 6
              }
            }
          }
        },
        {
          "name": "Slot7",
          "label": "能力槽 7",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 7
              }
            }
          }
        },
        {
          "name": "Slot8",
          "label": "能力槽 8",
          "pipeline_override": {
            "MaaNikki_BlingCombat": {
              "custom_action_param": {
                "goddess_slot": 8
              }
            }
          }
        }
      ]
    }
  }
}
