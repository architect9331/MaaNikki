{
  "task": [
    {
      "name": "fishing",
      "label": "当前点钓鱼",
      "entry": "MaaNikki_Fishing",
      "group": [
        "assist"
      ],
      "default_check": false,
      "description": "站在钓点并面向水面后启动，自动准备能力并抛竿。默认最多 3 竿，鱼已钓光时结束。",
      "option": [
        "FishingCastCount",
        "FishingAbilityPlan",
        "FishingRhythms"
      ]
    },
    {
      "name": "fishing_route",
      "label": "路线钓鱼",
      "entry": "MaaNikki_FishingRoute",
      "group": [
        "assist"
      ],
      "default_check": false,
      "description": "沿所选路线依次到点钓鱼，自动准备能力并按需传送。鱼已钓光时前往后续钓点，切出游戏时暂停。",
      "option": [
        "FishingRouteSelection",
        "FishingRouteCastCount",
        "FishingAbilityPlan",
        "FishingRhythms"
      ]
    }
  ],
  "option": {
    "FishingCastCount": {
      "type": "input",
      "label": "最多抛竿次数",
      "inputs": [
        {
          "name": "cast_count",
          "label": "抛竿次数",
          "default": "3",
          "verify": "^[1-9][0-9]*$",
          "pattern_msg": "请输入正整数。",
          "pipeline_type": "int",
          "input_type": "text"
        }
      ],
      "pipeline_override": {
        "MaaNikki_Fishing_CastCount": {
          "custom_action_param": {
            "value": "{cast_count}"
          }
        }
      }
    },
    "FishingAbilityPlan": {
      "type": "select",
      "label": "钓鱼允许使用的能力方案",
      "default_case": "Plan3",
      "description": "优先沿用当前钓鱼与打窝能力，缺少时在所选方案中配置。",
      "cases": [
        {
          "name": "Plan1",
          "label": "自定义方案一",
          "pipeline_override": {
            "MaaNikki_Fishing_AbilityPlan": {
              "custom_action_param": {
                "value": 1
              }
            }
          }
        },
        {
          "name": "Plan2",
          "label": "自定义方案二",
          "pipeline_override": {
            "MaaNikki_Fishing_AbilityPlan": {
              "custom_action_param": {
                "value": 2
              }
            }
          }
        },
        {
          "name": "Plan3",
          "label": "自定义方案三",
          "pipeline_override": {
            "MaaNikki_Fishing_AbilityPlan": {
              "custom_action_param": {
                "value": 3
              }
            }
          }
        }
      ]
    },
    "FishingRhythms": {
      "type": "switch",
      "label": "钓鱼前打窝",
      "default_case": "No",
      "description": "钓鱼前使用已解锁的万物交响能力，然后切换到钓鱼能力。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Fishing_Rhythms": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Fishing_Rhythms": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "FishingRouteSelection": {
      "type": "select",
      "label": "钓鱼路线",
      "default_case": "fishing_chef_hat_florawish",
      "cases": [
        {
          "name": "fishing_chef_hat_florawish",
          "label": "花愿镇 · 厨师帽鱼",
          "pipeline_override": {
            "MaaNikki_FishingRoute_Selection": {
              "custom_action_param": {
                "value": "fishing_chef_hat_florawish"
              }
            }
          }
        }
      ]
    },
    "FishingRouteCastCount": {
      "type": "input",
      "label": "每个钓点最多抛竿次数",
      "description": "填写每个钓点的抛竿次数；留空时沿用路线设置，路线未指定时最多 3 竿。",
      "inputs": [
        {
          "name": "cast_count",
          "label": "抛竿次数（留空沿用路线）",
          "default": "",
          "verify": "^(?:[1-9][0-9]*)?$",
          "pattern_msg": "请输入正整数，或留空沿用路线。",
          "pipeline_type": "string",
          "input_type": "text"
        }
      ],
      "pipeline_override": {
        "MaaNikki_FishingRoute_CastCount": {
          "custom_action_param": {
            "value": "{cast_count}"
          }
        }
      }
    }
  }
}
