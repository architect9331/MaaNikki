{
  "global_option": [
    "FishingCastCount",
    "FishingAbilityPlan",
    "FishingRhythms"
  ],
  "option": {
    "FishingCastCount": {
      "type": "input",
      "label": "最多抛竿次数",
      "inputs": [
        {
          "name": "cast_count",
          "label": "抛竿次数",
          "default": "3",
          "verify": "^[1-9][0-9]*$",
          "pattern_msg": "请输入正整数。",
          "pipeline_type": "int",
          "input_type": "text"
        }
      ],
      "pipeline_override": {
        "MaaNikki_Fishing_CastCount": {
          "custom_action_param": {
            "value": "{cast_count}"
          }
        }
      }
    },
    "FishingAbilityPlan": {
      "type": "select",
      "label": "钓鱼允许使用的能力方案",
      "default_case": "Plan3",
      "description": "优先沿用当前钓鱼与打窝能力，缺少时在所选方案中配置。",
      "cases": [
        {
          "name": "Plan1",
          "label": "自定义方案一",
          "pipeline_override": {
            "MaaNikki_Fishing_AbilityPlan": {
              "custom_action_param": {
                "value": 1
              }
            }
          }
        },
        {
          "name": "Plan2",
          "label": "自定义方案二",
          "pipeline_override": {
            "MaaNikki_Fishing_AbilityPlan": {
              "custom_action_param": {
                "value": 2
              }
            }
          }
        },
        {
          "name": "Plan3",
          "label": "自定义方案三",
          "pipeline_override": {
            "MaaNikki_Fishing_AbilityPlan": {
              "custom_action_param": {
                "value": 3
              }
            }
          }
        }
      ]
    },
    "FishingRhythms": {
      "type": "switch",
      "label": "钓鱼前打窝",
      "default_case": "No",
      "description": "钓鱼前使用已解锁的万物交响能力，然后切换到钓鱼能力。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Fishing_Rhythms": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Fishing_Rhythms": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    }
  }
}
