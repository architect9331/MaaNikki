{
  "task": [
    {
      "name": "xinghai",
      "label": "星海拾光",
      "entry": "MaaNikki_Xinghai",
      "group": [
        "daily"
      ],
      "default_check": true,
      "description": "按所选子任务和执行优先级补足 500 分并领奖。跑图需提前解锁地图与传送点，并使用前台输入。",
      "option": [
        "XinghaiTask_bell",
        "XinghaiTask_animal_three",
        "XinghaiTask_photo",
        "XinghaiTask_place",
        "XinghaiTask_like",
        "XinghaiTask_music",
        "XinghaiTask_chat",
        "XinghaiTask_animal_one",
        "XinghaiTask_bottle",
        "XinghaiTask_bottle_photo",
        "XinghaiTask_meteor",
        "XinghaiTask_wing_photo",
        "XinghaiTask_delivery",
        "XinghaiTask_bubble",
        "XinghaiForceCrystal",
        "XinghaiChatText",
        "XinghaiPhoto",
        "XinghaiClaim"
      ]
    }
  ],
  "option": {
    "XinghaiForceCrystal": {
      "type": "switch",
      "label": "收集星光结晶（100 分）",
      "default_case": "Yes",
      "description": "当天出现结晶任务且需要补分时，执行星光结晶收集流程。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_Xinghai_DailyForceCrystal": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_Xinghai_DailyForceCrystal": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "XinghaiChatText": {
      "type": "input",
      "layout": "inline",
      "label": "聚会消息",
      "inputs": [
        {
          "name": "Text",
          "label": "内容",
          "default": "1",
          "pipeline_type": "string",
          "verify": "^.{1,40}$"
        }
      ],
      "pipeline_override": {
        "MaaNikki_Xinghai_DailyChatText": {
          "custom_action_param": {
            "value": "{Text}"
          }
        }
      },
      "description": "当天需要完成聊天任务时，向聚会频道发送一次此消息。"
    },
    "XinghaiPhoto": {
      "type": "switch",
      "label": "删除本次自动拍摄的任务照片",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "删除本次照片",
          "pipeline_override": {
            "MaaNikki_Xinghai_DailyPhoto": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "保留",
          "pipeline_override": {
            "MaaNikki_Xinghai_DailyPhoto": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "XinghaiClaim": {
      "type": "switch",
      "label": "领取星海拾光奖励",
      "cases": [
        {
          "name": "Yes",
          "label": "领取",
          "pipeline_override": {
            "MaaNikki_ClaimXinghaiRewards": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "label": "不领取",
          "pipeline_override": {
            "MaaNikki_ClaimXinghaiRewards": {
              "enabled": false
            }
          }
        }
      ],
      "default_case": "Yes"
    },
