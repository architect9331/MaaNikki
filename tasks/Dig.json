            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "MaaNikki_Dig_Again": {"enabled": true}
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "MaaNikki_Dig_Again": {"enabled": false}
                    }
                }
            ],
            "default_case": "Yes"
        }
    }
}
