{
    "task": [
        {
            "name": "realm_challenge",
            "label": "幻境挑战",
            "entry": "MaaNikki_RealmChallenge",
            "group": [
                "daily"
            ],
            "default_check": true,
            "description": "按「刷取顺序」使用活跃能量：每批挑战前选择排在最前、仍有缺口的目标（每周幻境、焕新材料、制衣材料、五星闪光），都完成后交给兜底副本。与朝夕心愿同轮运行时，请排在朝夕心愿之后。",
            "option": [
                "WeeklyTargets",
                "RealmQueue",
                "RealmTypes",
                "CollectionWorkflow",
                "CollectionReserveBling",
                "CollectionBling",
                "CollectionDecompose",
                "CollectionOrganize",
                "JihuaTarget",
                "JihuaMaterialMode",
                "BlessTarget",
                "MonsterTarget"
            ]
        }
    ],
    "option": {
        "RealmTypes": {
            "type": "select",
            "label": "兜底副本",
            "description": "刷取顺序中的目标都完成或未开启时，剩余活跃能量的用途。",
            "cases": [
                {
                    "name": "Jihua",
                    "label": "素材激化",
                    "pipeline_override": {
                        "MaaNikki_RealmEnergy": {
                            "next": [
                                "MaaNikki_Jihua"
                            ]
                        }
                    }
                },
                {
                    "name": "Bless",
                    "label": "祝福闪光",
                    "pipeline_override": {
                        "MaaNikki_RealmEnergy": {
                            "next": [
                                "MaaNikki_Bless"
                            ]
                        }
                    }
                },
                {
                    "name": "Monster",
                    "label": "魔物试炼",
                    "pipeline_override": {
                        "MaaNikki_RealmEnergy": {
                            "next": [
                                "MaaNikki_Monster"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Bless"
        },
        "CollectionWorkflow": {
            "type": "select",
            "label": "全收集执行模式",
            "description": "「全流程托管」自动整理、刷本、分解、升级并锁定满级新颜色；「只刷胚子」仅根据当前仓库满级颜色与待升级胚子计算期望自动选本刷取，不改动锁定、不分解、不升级。",
            "cases": [
                {
                    "name": "Managed",
                    "label": "全流程托管（刷本 + 升级 + 锁定）",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_WorkflowOption": {
                            "custom_action_param": {
                                "mode": "managed"
                            }
                        }
                    }
                },
                {
                    "name": "FarmOnly",
                    "label": "只刷胚子（仅按仓库自动选本）",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_WorkflowOption": {
                            "custom_action_param": {
                                "mode": "farm_only"
                            }
                        }
                    }
                }
            ],
            "default_case": "Managed"
        },
        "CollectionReserveBling": {
            "type": "input",
            "label": "保留噗灵数",
            "description": "升级祝福闪光时保证剩余噗灵不低于此数值（设为 0 表示不保留）。当扣除当次升级费用后噗灵会低于保留数时，停止升级并按下方设置决定是否改刷噗灵。",
            "inputs": [
                {
                    "name": "amount",
                    "label": "保留噗灵数",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入非负整数（如 0 或 500000）"
                }
            ],
            "pipeline_override": {
                "MaaNikki_Pursuit_ReserveBlingOption": {
                    "custom_action_param": {
                        "amount": "{amount}"
                    }
                }
            }
        },
        "CollectionBling": {
            "type": "switch",
            "label": "噗灵不足时改刷噗灵",
            "description": "推荐开启：每次升级要 72000 噗灵，全收集时噗灵比胚子先用完。每天先升级已有胚子：噗灵不够、胚子还升不起时，当天活跃能量全部改做素材激化，消耗下方设置的材料；胚子都升完了才继续刷本。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_BlingOption": {
                            "custom_action_param": {
                                "enabled": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_BlingOption": {
                            "custom_action_param": {
                                "enabled": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "CollectionDecompose": {
            "type": "switch",
            "label": "爆仓时分解重复祝福闪光",
            "description": "仓库满 1000 格时无法刷本。开启后，仓库满且没有待升级胚子时，用「五星及以下素材」一键分解一批（最多 100 件）。分解不可恢复：请勿手动解锁已收藏的祝福闪光，并锁定其他想保留的闪光。关闭时仓库满了会停止刷本。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_DecomposeOption": {
                            "custom_action_param": {
                                "enabled": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_DecomposeOption": {
                            "custom_action_param": {
                                "enabled": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "CollectionOrganize": {
            "type": "select",
            "label": "仓库整理",
            "description": "自动只在没有可用记录时整理。手动大量改动仓库后，可临时改为每次整理，运行一次后改回自动。",
            "cases": [
                {
                    "name": "Auto",
                    "label": "自动（推荐）",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_OrganizeOption": {
                            "custom_action_param": {
                                "mode": "auto"
                            }
                        }
                    }
                },
                {
                    "name": "Always",
                    "label": "每次运行前整理（只补充锁定）",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_OrganizeOption": {
                            "custom_action_param": {
                                "mode": "always"
                            }
                        }
                    }
                },
                {
                    "name": "AlwaysUnlock",
                    "label": "每次运行前整理（并解锁未满级及多余重复项）",
                    "pipeline_override": {
                        "MaaNikki_Pursuit_OrganizeOption": {
                            "custom_action_param": {
                                "mode": "always_unlock"
                            }
                        }
                    }
                }
            ],
            "default_case": "Auto"
        },
        "JihuaTarget": {
            "type": "select",
            "label": "素材激化目标",
            "cases": [
                {
                    "name": "Bubble",
                    "label": "闪亮泡泡",
                    "pipeline_override": {
                        "MaaNikki_Jihua_Target": {
                            "expected": "闪亮泡泡"
                        },
                        "MaaNikki_Jihua_TargetRetry": {
                            "expected": "闪亮泡泡"
                        }
                    }
                },
                {
                    "name": "Bling",
                    "label": "噗灵",
                    "pipeline_override": {
                        "MaaNikki_Jihua_Target": {
                            "expected": "噗灵"
                        },
                        "MaaNikki_Jihua_TargetRetry": {
                            "expected": "噗灵"
                        }
                    }
                },
                {
                    "name": "Thread",
                    "label": "丝线",
                    "pipeline_override": {
                        "MaaNikki_Jihua_Target": {
                            "expected": "丝线"
                        },
                        "MaaNikki_Jihua_TargetRetry": {
                            "expected": "丝线"
                        }
                    }
                }
            ],
            "default_case": "Bubble"
        },
        "JihuaMaterialMode": {
            "type": "select",
            "label": "消耗材料选择方式",
            "description": "选择数量最多的材料，或按指定的首选与备选顺序使用。",
            "cases": [
                {
                    "name": "Priority",
                    "label": "按优先级选择",
                    "option": [
                        "JihuaMaterials"
                    ],
                    "pipeline_override": {
                        "MaaNikki_Jihua_MaterialMostOpen": {
                            "enabled": false
                        },
                        "MaaNikki_Jihua_Material": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "Most",
                    "label": "选择数量最多的材料",
                    "pipeline_override": {
                        "MaaNikki_Jihua_MaterialMostOpen": {
                            "enabled": true
                        },
                        "MaaNikki_Jihua_Material": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Priority"
        },
        "JihuaMaterials": {
            "type": "input",
            "label": "消耗材料优先级",
            "description": "填写材料的完整名称，按首选、备选顺序尝试。",
            "inputs": [
                {
                    "name": "Primary",
                    "label": "首选",
                    "default": "星荧草",
                    "pipeline_type": "string",
                    "verify": "^.{1,12}$"
                },
                {
                    "name": "Backup1",
                    "label": "备选 1",
                    "default": "纽扣松果",
                    "pipeline_type": "string",
                    "verify": "^.{1,12}$"
                },
                {
                    "name": "Backup2",
                    "label": "备选 2",
                    "default": "小棉菊",
                    "pipeline_type": "string",
                    "verify": "^.{1,12}$"
                }
            ],
            "pipeline_override": {
                "MaaNikki_Jihua_Material": {
                    "expected": [
                        "{Primary}",
                        "{Backup1}",
                        "{Backup2}"
                    ]
                }
            }
        },
