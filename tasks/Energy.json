{
    "task": [
        {
            "name": "realm_challenge",
            "label": "幻境挑战",
            "entry": "MaaNikki_RealmChallenge",
            "group": [
                "energy"
            ],
            "default_check": true,
            "description": "请排在朝夕心愿之后执行。先按开关处理周本，再用所选普通幻境的最大次数消耗剩余体力。同一轮朝夕尚未满分且有累计体力条件时，最后只复核朝夕积分和领奖，不重复执行日常；单跑本项不打开朝夕页面。",
            "option": [
                "WeeklyEnabled",
                "RealmTypes"
            ]
        }
    ],
    "option": {
        "WeeklyEnabled": {
            "type": "switch",
            "label": "优先完成每周幻境",
            "description": "开启后先检查本周剩余挑战次数；本周已完成时自动跳过。之后使用剩余活跃能量挑战下面选择的幻境。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "WeeklyTargets"
                    ],
                    "pipeline_override": {
                        "MaaNikki_RealmWeekly": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "MaaNikki_RealmWeekly": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "RealmTypes": {
            "type": "select",
            "label": "剩余体力消耗方式",
            "description": "选择一种幻境，自动使用最大次数消耗剩余活跃能量。不足一次所需的剩余活跃能量会保留。",
            "cases": [
                {
                    "name": "Jihua",
                    "label": "素材激化",
                    "option": [
                        "JihuaTarget",
                        "JihuaMaterialMode"
                    ],
                    "pipeline_override": {
                        "MaaNikki_RealmEnergy": {
                            "next": [
                                "MaaNikki_Jihua"
                            ]
                        }
                    }
                },
                {
                    "name": "Bless",
                    "label": "祝福闪光",
                    "option": [
                        "BlessTarget"
                    ],
                    "pipeline_override": {
                        "MaaNikki_RealmEnergy": {
                            "next": [
                                "MaaNikki_Bless"
                            ]
                        }
                    }
                },
                {
                    "name": "Monster",
                    "label": "魔物试炼",
                    "option": [
                        "MonsterTarget"
                    ],
                    "pipeline_override": {
                        "MaaNikki_RealmEnergy": {
                            "next": [
                                "MaaNikki_Monster"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Bless"
        },
        "JihuaTarget": {
            "type": "select",
            "label": "兑换目标",
            "cases": [
                {
                    "name": "Bubble",
                    "label": "闪亮泡泡",
                    "pipeline_override": {
                        "MaaNikki_Jihua_Target": {
                            "expected": "闪亮泡泡"
                        },
                        "MaaNikki_Jihua_TargetRetry": {
                            "expected": "闪亮泡泡"
                        }
                    }
                },
                {
                    "name": "Bling",
                    "label": "噗灵",
                    "pipeline_override": {
                        "MaaNikki_Jihua_Target": {
                            "expected": "噗灵"
                        },
                        "MaaNikki_Jihua_TargetRetry": {
                            "expected": "噗灵"
                        }
                    }
                },
                {
                    "name": "Thread",
                    "label": "丝线",
                    "pipeline_override": {
                        "MaaNikki_Jihua_Target": {
                            "expected": "丝线"
                        },
                        "MaaNikki_Jihua_TargetRetry": {
                            "expected": "丝线"
                        }
                    }
                }
            ],
            "default_case": "Bubble"
        },
        "JihuaMaterialMode": {
            "type": "select",
            "label": "消耗材料选择方式",
            "description": "选择数量最多的材料，或使用指定的首选与备选材料。",
            "cases": [
                {
                    "name": "Priority",
                    "label": "按优先级选择",
                    "option": [
                        "JihuaMaterials"
                    ],
                    "pipeline_override": {
                        "MaaNikki_Jihua_MaterialMostOpen": {
                            "enabled": false
                        },
                        "MaaNikki_Jihua_Material": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "Most",
                    "label": "选择数量最多的材料",
                    "pipeline_override": {
                        "MaaNikki_Jihua_MaterialMostOpen": {
                            "enabled": true
                        },
                        "MaaNikki_Jihua_Material": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Priority"
        },
        "JihuaMaterials": {
            "type": "input",
            "label": "消耗材料优先级",
            "description": "填写材料在游戏中的完整名称。首选材料不可用时尝试备选材料。",
            "inputs": [
                {
                    "name": "Primary",
                    "label": "首选",
                    "default": "星荧草",
                    "pipeline_type": "string",
                    "verify": "^.{1,12}$"
                },
                {
                    "name": "Backup1",
                    "label": "备选 1",
                    "default": "纽扣松果",
                    "pipeline_type": "string",
                    "verify": "^.{1,12}$"
                },
                {
                    "name": "Backup2",
                    "label": "备选 2",
                    "default": "小棉菊",
                    "pipeline_type": "string",
                    "verify": "^.{1,12}$"
                }
            ],
            "pipeline_override": {
                "MaaNikki_Jihua_Material": {
                    "expected": [
                        "{Primary}",
                        "{Backup1}",
                        "{Backup2}"
                    ]
                }
            }
        },
