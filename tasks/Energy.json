        "WeeklyTargets": {
            "type": "checkbox",
            "label": "每周幻境目标",
            "description": "刷取顺序中的每周幻境轮到时，若本周仍有挑战次数，按所选目标依次挑战，每个目标一次。",
            "cases": [
                {
                    "name": "Qiggeda",
                    "label": "奇格格达",
                    "pipeline_override": {
                        "MaaNikki_Weekly_Level_Qiggeda": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "Juan",
                    "label": "卷卷",
                    "pipeline_override": {
                        "MaaNikki_Weekly_Level_Juan": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": [
                "Qiggeda",
                "Juan"
            ],
            "min_count": 1,
            "max_count": 2
        },
        "RealmQueue": {
            "type": "input",
            "label": "刷取顺序",
            "description": "按顺序排列每周幻境、焕新材料、制衣材料与五星闪光，可分别开关。每批挑战前选择排在最前、仍有缺口的目标；全部完成或未开启时，剩余活跃能量交给下方兜底副本。",
            "inputs": [
                {
                    "name": "order",
                    "label": "刷取顺序",
                    "default": "weekly,-renewal,-crafting,-glow",
                    "pipeline_type": "string",
                    "verify": "^-?(weekly|renewal|crafting|glow)(,-?(weekly|renewal|crafting|glow))*$",
                    "pattern_msg": "请在任务设置的刷取顺序卡片中调整"
                }
            ],
            "pipeline_override": {
                "MaaNikki_RealmQueue": {
                    "custom_action_param": {
                        "order": "{order}"
                    }
                }
            }
        }
    }
}
