{
  "task": [
    {
      "name": "zhaoxi",
      "label": "朝夕心愿",
      "entry": "MaaNikki_Zhaoxi",
      "group": [
        "daily"
      ],
      "default_check": true,
      "description": "优先完成已适配项目，按需通过幻境补足 500 分并领奖。升级心愿优先选择五星；同轮全收集时等待其升级后复核领奖。",
      "option": [
        "ZhaoxiAbilityPlan",
        "ZhaoxiEnergy",
        "ZhaoxiPhoto",
        "ZhaoxiClaim"
      ]
    }
  ],
  "option": {
    "ZhaoxiAbilityPlan": {
      "type": "select",
      "label": "捕虫允许使用的能力方案",
      "default_case": "Plan3",
      "description": "优先沿用当前捕虫能力，缺少时切换到所选方案；该方案仍缺少捕虫时，将第 8 槽配置为捕虫。",
      "cases": [
        {
          "name": "Plan1",
          "label": "自定义方案一",
          "pipeline_override": {
            "MaaNikki_Zhaoxi_DailyAbilityPlan": {
              "custom_action_param": {
                "value": 1
              }
            }
          }
        },
        {
          "name": "Plan2",
          "label": "自定义方案二",
          "pipeline_override": {
            "MaaNikki_Zhaoxi_DailyAbilityPlan": {
              "custom_action_param": {
                "value": 2
              }
            }
          }
        },
        {
          "name": "Plan3",
          "label": "自定义方案三",
          "pipeline_override": {
            "MaaNikki_Zhaoxi_DailyAbilityPlan": {
              "custom_action_param": {
                "value": 3
              }
            }
          }
        }
      ]
    },
    "ZhaoxiEnergy": {
      "type": "switch",
      "label": "允许用活跃能量补足心愿积分",
      "default_case": "Yes",
      "description": "积分不足 500 分时，按当天要求和游戏默认最少次数挑战幻境。目标与材料沿用幻境挑战设置。",
      "cases": [
        {
          "name": "Yes",
          "label": "允许",
          "pipeline_override": {
            "MaaNikki_Zhaoxi_DailyEnergy": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "不消耗活跃能量",
          "pipeline_override": {
            "MaaNikki_Zhaoxi_DailyEnergy": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "ZhaoxiPhoto": {
      "type": "switch",
      "label": "删除本次自动拍摄的任务照片",
      "default_case": "No",
      "description": "开启后删除本次任务拍摄的照片；关闭时保留照片。",
      "cases": [
        {
          "name": "Yes",
          "label": "删除本次照片",
          "pipeline_override": {
            "MaaNikki_Zhaoxi_DailyPhoto": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "保留",
          "pipeline_override": {
            "MaaNikki_Zhaoxi_DailyPhoto": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "ZhaoxiClaim": {
      "type": "switch",
      "label": "领取朝夕心愿奖励",
      "cases": [
        {
          "name": "Yes",
          "label": "领取",
          "pipeline_override": {
            "MaaNikki_ClaimZhaoxiRewards": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "label": "仅检查积分",
          "pipeline_override": {
            "MaaNikki_ClaimZhaoxiRewards": {
              "enabled": false
            }
          }
        }
      ],
      "default_case": "Yes"
    }
  }
}
