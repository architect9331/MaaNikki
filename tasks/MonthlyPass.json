{
    "task": [
        {
            "name": "monthly_pass",
            "label": "奇迹之旅奖励",
            "entry": "MaaNikki_MonthlyPass",
            "group": ["daily"],
            "default_check": true,
            "description": "先处理当前打开的界面，再通过左下角切换处理另一个。奇迹之旅领取所选任务与秘宝，乐园构想只领取任务奖励。",
            "option": ["MonthlyIntro", "MonthlyPages"]
        }
    ],
    "option": {
        "MonthlyIntro": {
            "type": "switch",
            "label": "处理首次介绍动画",
            "cases": [
                {
                    "name": "Yes",
                    "label": "自动跳过",
                    "pipeline_override": {
                        "MaaNikki_Monthly_IntroSkip": {"enabled": true}
                    }
                },
                {
                    "name": "No",
                    "label": "不处理",
                    "pipeline_override": {
                        "MaaNikki_Monthly_IntroSkip": {"enabled": false}
                    }
                }
            ],
            "default_case": "Yes"
        },
        "MonthlyPages": {
            "type": "checkbox",
            "label": "领取页签",
            "description": "两个界面都会处理。奇迹之旅默认先领旅行任务，再领旅行秘宝；乐园构想沿用旅行任务选项，只领取乐园纪事奖励。",
            "cases": [
                {
                    "name": "Task",
                    "label": "旅行任务",
                    "pipeline_override": {
                        "MaaNikki_Monthly_TaskTab": {"enabled": true}
                    }
                },
                {
                    "name": "Treasure",
                    "label": "旅行秘宝",
                    "pipeline_override": {
                        "MaaNikki_Monthly_TreasureTab": {"enabled": true}
                    }
                }
            ],
            "default_case": ["Task", "Treasure"],
            "min_count": 1,
            "max_count": 2
        }
    }
}
