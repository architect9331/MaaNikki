{
  "global_option": [
    "GungunjiPullMode",
    "GungunjiMaxPulls",
    "GungunjiReserveBling"
  ],
  "option": {
    "GungunjiPullMode": {
      "type": "select",
      "label": "抽取方式",
      "default_case": "Ten",
      "description": "十连抽每次消耗 20 万噗灵，单抽每次消耗 2 万噗灵。",
      "cases": [
        {
          "name": "Ten",
          "label": "十连抽（20 万噗灵/轮）",
          "pipeline_override": {
            "MaaNikki_Gungunji_PullMode": {
              "custom_action_param": {
                "value": "ten"
              }
            }
          }
        },
        {
          "name": "Single",
          "label": "单抽（2 万噗灵/轮）",
          "pipeline_override": {
            "MaaNikki_Gungunji_PullMode": {
              "custom_action_param": {
                "value": "single"
              }
            }
          }
        }
      ]
    },
    "GungunjiMaxPulls": {
      "type": "input",
      "label": "最多抽取轮数",
      "description": "十连抽按十连次数计，单抽按单抽次数计；达到上限后自动停止。",
      "inputs": [
        {
          "name": "max_pulls",
          "label": "轮数上限",
          "default": "10",
          "verify": "^[1-9][0-9]*$",
          "pattern_msg": "请输入正整数。",
          "pipeline_type": "int",
          "input_type": "text"
        }
      ],
      "pipeline_override": {
        "MaaNikki_Gungunji_MaxPulls": {
          "custom_action_param": {
            "value": "{max_pulls}"
          }
        }
      }
    },
    "GungunjiReserveBling": {
      "type": "input",
      "label": "保留噗灵下限",
      "description": "抽取前检测到本次消耗后余额低于该数值时立即停止，防止误抽光噗灵（填 0 表示不保留）。",
      "inputs": [
        {
          "name": "reserve_bling",
          "label": "保留噗灵",
          "default": "1000000",
          "verify": "^[0-9]+$",
          "pattern_msg": "请输入非负整数。",
          "pipeline_type": "int",
          "input_type": "text"
        }
      ],
      "pipeline_override": {
        "MaaNikki_Gungunji_ReserveBling": {
          "custom_action_param": {
            "value": "{reserve_bling}"
          }
        }
      }
    }
  }
}
