{
  "task": [
    {
      "name": "blessing_lock",
      "label": "一键整理祝福闪光",
      "entry": "MaaNikki_BlessingLock",
      "group": [
        "collection"
      ],
      "default_check": false,
      "description": "扫描三个部位的祝福闪光，锁定每款每色的满级收藏，并保存全收集基准。运行前请清除仓库筛选；换号或手动整理库存后请重新运行。",
      "option": [
        "BlessingLockUnlockNonconforming"
      ]
    }
  ],
  "option": {
    "BlessingLockUnlockNonconforming": {
      "type": "select",
      "label": "解锁不符合要求的祝福闪光",
      "description": "关闭时补锁缺少的满级颜色；开启时同时解锁未满级和多余重复项。",
      "default_case": "Off",
      "cases": [
        {
          "name": "Off",
          "label": "关闭（只补锁）",
          "pipeline_override": {
            "MaaNikki_BlessingLock": {
              "custom_action_param": {
                "unlock_nonconforming": false
              }
            }
          }
        },
        {
          "name": "On",
          "label": "开启（同时解锁未满级及多余重复项）",
          "pipeline_override": {
            "MaaNikki_BlessingLock": {
              "custom_action_param": {
                "unlock_nonconforming": true
              }
            }
          }
        }
      ]
    }
  }
}
