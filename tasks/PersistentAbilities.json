    },
    "PersistentAbilityPlan": {
      "type": "select",
      "label": "允许修改的能力方案",
      "default_case": "Plan3",
      "description": "优先沿用当前能力轮盘中已有的能力；缺少所选常驻能力时，切换到该方案并优先装入五至七号槽位（避开日常任务复用的八号槽位，防止金鹰之眼等能力被后续替换失效）。",
      "cases": [
