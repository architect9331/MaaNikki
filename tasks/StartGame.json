{
  "pretask": [
    {
      "name": "start_game",
      "label": "启动游戏",
      "description": "通过官方启动器启动游戏，处理更新和重启后进入主页。此任务优先执行，切出窗口时暂停，切回后继续。",
      "controller": ["nikki_windows"],
      "exec": "./python/python.exe",
      "args": ["./agent/start_game.py"],
      "option": ["StartGameProgram", "StartGameTimeout"],
      "entry": "MaaNikki_StartGame",
      "required": true,
      "default_check": true,
      "cancel_on_stop": true
    }
  ],
  "option": {
    "StartGameProgram": {
      "type": "input",
      "label": "官方启动器路径",
      "description": "留空时自动查找启动器，也可选择安装目录中的 launcher.exe。",
      "inputs": [
        {"name": "path", "label": "官方启动器", "default": "", "input_type": "file"}
      ]
    },
    "StartGameTimeout": {
      "type": "input",
      "label": "启动等待上限（秒）",
      "description": "设置启动、更新和进入游戏的总等待上限，默认 900 秒。暂停期间停止计时。",
      "inputs": [
        {"name": "seconds", "default": "900", "pipeline_type": "int", "verify": "^(?:[3-9][0-9]|[1-8][0-9]{2}|900)$", "pattern_msg": "请输入30至900之间的秒数。"}
      ],
      "pipeline_override": {
        "MaaNikki_StartGame": {"custom_action_param": {"timeout": "{seconds}"}}
      }
    }
  }
}
