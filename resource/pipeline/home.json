  },
  "MaaNikki_Home_StarCollectExhaustedIcon": {
    "recognition": "Custom",
    "custom_recognition": "nikki.ui_template",
    "custom_recognition_param": {
      "roi": [1165, 15, 80, 55],
      "template": "nikki/home/star_collect_exhausted.png",
      "color": [[0, 0, 100], [180, 90, 220]],
