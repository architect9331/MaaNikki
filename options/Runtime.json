{
  "global_option": [
    "FocusLostBehavior",
    "RouteOverlayMode"
  ],
  "setting": [
    {
      "name": "runtime_behavior",
      "label": "运行行为",
      "option": [
        "FocusLostBehavior",
        "RouteOverlayMode"
      ],
      "default_expand": true
    }
  ],
  "option": {
    "FocusLostBehavior": {
      "type": "select",
      "label": "游戏离开前台时",
      "description": "任务运行中切出游戏时的处理方式。自动暂停：等你切回后继续。回到游戏：每隔几秒把游戏切回前台继续运行，想操作其他窗口时请先停止任务。辅助功能不受影响。",
      "default_case": "Pause",
      "cases": [
        {
          "name": "Pause",
          "label": "自动暂停",
          "pipeline_override": {
            "MaaNikki_FocusLost": {
              "custom_action_param": {
                "mode": "pause"
              }
            }
          }
        },
        {
          "name": "Return",
          "label": "回到游戏",
          "pipeline_override": {
            "MaaNikki_FocusLost": {
              "custom_action_param": {
                "mode": "return"
              }
            }
          }
        }
      ]
    },
    "RouteOverlayMode": {
      "type": "select",
      "label": "跑图路径遮罩",
      "description": "日常跑图、大世界材料采集、自定义路线与路线编辑器试跑／录制期间，游戏画面实时叠加的路径导航遮罩显示方式（防截图且不阻挡鼠标点击）。",
      "default_case": "Full",
      "cases": [
        {
          "name": "Full",
          "label": "开启（3D 地面 AR 引导 + 小地图遮罩）",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "full"
              }
            }
          }
        },
        {
          "name": "MinimapOnly",
          "label": "仅左上角小地图遮罩（关闭 3D 地面引导）",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "minimap"
              }
            }
          }
        },
        {
          "name": "Off",
          "label": "关闭路径遮罩",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "off"
              }
            }
          }
        }
      ]
    }
  }
}
