{
  "global_option": [
    "AutoAdjustResolution",
    "FocusLostBehavior",
    "RouteOverlayMode"
  ],
  "setting": [
    {
      "name": "runtime_behavior",
      "label": "运行行为",
      "option": [
        "AutoAdjustResolution",
        "FocusLostBehavior",
        "RouteOverlayMode"
      ],
      "default_expand": true
    }
  ],
  "option": {
    "AutoAdjustResolution": {
      "type": "switch",
      "label": "自动调整游戏分辨率",
      "default_case": "Yes",
      "description": "运行任务期间，当游戏窗口不是标准 16:9 或超出屏幕边界时，自动临时切换为当前显示器上最相近的 16:9 无边框窗口（整理祝福闪光或读取图鉴时也会临时切换超长竖屏加速扫描），并在任务结束后恢复原窗口尺寸与位置。独占全屏模式下无法调整。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_AutoAdjustResolution": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_AutoAdjustResolution": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "FocusLostBehavior": {
      "type": "select",
      "label": "游戏离开前台时",
      "description": "任务运行中切出游戏时的处理方式。自动暂停：等你切回后继续。回到游戏：每隔几秒把游戏切回前台继续运行，想操作其他窗口时请先停止任务。辅助功能不受影响。",
      "default_case": "Pause",
      "cases": [
        {
          "name": "Pause",
          "label": "自动暂停",
          "pipeline_override": {
            "MaaNikki_FocusLost": {
              "custom_action_param": {
                "mode": "pause"
              }
            }
          }
        },
        {
          "name": "Return",
          "label": "回到游戏",
          "pipeline_override": {
            "MaaNikki_FocusLost": {
              "custom_action_param": {
                "mode": "return"
              }
            }
          }
        }
      ]
    },
    "RouteOverlayMode": {
      "type": "select",
      "label": "跑图路径遮罩",
      "description": "日常跑图、大世界材料采集、自定义路线与路线编辑器试跑／录制期间，游戏画面实时叠加的路径导航遮罩显示方式（防截图且不阻挡鼠标点击）。",
      "default_case": "Full",
      "cases": [
        {
          "name": "Full",
          "label": "开启（3D 地面 AR 引导 + 小地图遮罩）",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "full"
              }
            }
          }
        },
        {
          "name": "MinimapOnly",
          "label": "仅左上角小地图遮罩（关闭 3D 地面引导）",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "minimap"
              }
            }
          }
        },
        {
          "name": "Off",
          "label": "关闭路径遮罩",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "off"
              }
            }
          }
        }
      ]
    }
  }
}
