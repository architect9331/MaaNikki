{
  "global_option": [
    "AutoAdjustResolution",
    "FocusLostBehavior",
    "RouteOverlayMode",
    "TaskHudMode"
  ],
  "setting": [
    {
      "name": "runtime_behavior",
      "label": "运行行为",
      "option": [
        "AutoAdjustResolution",
        "FocusLostBehavior",
        "RouteOverlayMode",
        "TaskHudMode"
      ],
      "default_expand": true
    }
  ],
  "option": {
    "AutoAdjustResolution": {
      "type": "switch",
      "label": "自动调整游戏分辨率",
      "default_case": "Yes",
      "description": "运行任务期间，当游戏窗口不是标准 16:9 或超出屏幕边界时，自动临时切换为当前显示器上最相近的 16:9 无边框窗口（整理祝福闪光或读取图鉴时也会临时切换超长竖屏加速扫描），并在任务结束后恢复原窗口尺寸与位置。独占全屏模式下无法调整。",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "MaaNikki_AutoAdjustResolution": {
              "custom_action_param": {
                "value": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "MaaNikki_AutoAdjustResolution": {
              "custom_action_param": {
                "value": false
              }
            }
          }
        }
      ]
    },
    "FocusLostBehavior": {
      "type": "select",
      "label": "游戏离开前台时",
      "description": "任务运行中切出游戏时的处理方式。自动暂停：等你切回后继续。回到游戏：每隔几秒把游戏切回前台继续运行。后台运行：不抢焦点不切回，点击或拖曳界面时瞬时借用鼠标后立即归还，自动寻路按小地图视角实时闭环控制 WASD 全向行进（无需频繁重置镜头，游戏内开启或关闭镜头水平辅助均可兼容；需使用支持后台的截图方式且不能最小化游戏；遇到放置摆饰、钓鱼、捕虫、战斗等需要物理鼠标或调视角的任务阶段会自动抢占并保持游戏在前台，结束后恢复后台）。",
      "default_case": "Pause",
      "cases": [
        {
          "name": "Pause",
          "label": "自动暂停",
          "pipeline_override": {
            "MaaNikki_FocusLost": {
              "custom_action_param": {
                "mode": "pause"
              }
            }
          }
        },
        {
          "name": "Return",
          "label": "回到游戏",
          "pipeline_override": {
            "MaaNikki_FocusLost": {
              "custom_action_param": {
                "mode": "return"
              }
            }
          }
        },
        {
          "name": "Background",
          "label": "后台运行（WASD 后台寻路 + 瞬时借位点击）",
          "pipeline_override": {
            "MaaNikki_FocusLost": {
              "custom_action_param": {
                "mode": "background"
              }
            }
          }
        }
      ]
    },
    "RouteOverlayMode": {
      "type": "select",
      "label": "跑图路径遮罩",
      "description": "日常跑图、大世界材料采集、自定义路线与路线编辑器试跑／录制期间，游戏画面实时叠加的路径导航遮罩显示方式（防截图且不阻挡鼠标点击）。",
      "default_case": "Full",
      "cases": [
        {
          "name": "Full",
          "label": "开启（3D 地面 AR 引导 + 小地图遮罩）",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "full"
              }
            }
          }
        },
        {
          "name": "MinimapOnly",
          "label": "仅左上角小地图遮罩（关闭 3D 地面引导）",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "minimap"
              }
            }
          }
        },
        {
          "name": "Off",
          "label": "关闭路径遮罩",
          "pipeline_override": {
            "MaaNikki_RouteOverlay": {
              "custom_action_param": {
                "mode": "off"
              }
            }
          }
        }
      ]
    },
    "TaskHudMode": {
      "type": "select",
      "label": "画面状态与切窗原因提示",
      "description": "任务运行期间在游戏画面顶部统一展示当前任务、运行模式与强切回前台原因（样式同步软件主题与强调色，防截图且不阻挡鼠标）。智能自适应：在前后台切换或强制切回时弹出原因说明，后台运行、跑图与探索辅助显示详细进度，普通前台任务使用紧凑单行条；始终完整显示：全程双行展示当前任务与步骤；仅需关注时显示：仅在强切前台、离开暂停或恢复后台时显示原因提示。",
      "default_case": "Adaptive",
      "cases": [
        {
          "name": "Adaptive",
          "label": "智能自适应（推荐）",
          "pipeline_override": {
            "MaaNikki_TaskHud": {
              "custom_action_param": {
                "mode": "adaptive"
              }
            }
          }
        },
        {
          "name": "Always",
          "label": "始终完整显示",
          "pipeline_override": {
            "MaaNikki_TaskHud": {
              "custom_action_param": {
                "mode": "always"
              }
            }
          }
        },
        {
          "name": "ReasonOnly",
          "label": "仅在需要关注时显示原因",
          "pipeline_override": {
            "MaaNikki_TaskHud": {
              "custom_action_param": {
                "mode": "reason_only"
              }
            }
          }
        }
      ]
    }
  }
}
